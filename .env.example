# Public site URL (used for absolute metadata/OG URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nerdverso?schema=public"

# Initial owner account created by `npx prisma db seed` (dev only — omit in
# production and create the owner through a secure one-time setup instead)
OWNER_EMAIL=""
OWNER_PASSWORD=""

# Auth.js — generate with `npx auth secret` in production
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Image storage (S3-compatible). Leave empty in development to use local /public uploads.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# Payment providers (prepared, not required for local development)
PAYMENT_PROVIDER_PIX_KEY=""
PAYMENT_PROVIDER_STRIPE_SECRET_KEY=""
PAYMENT_PROVIDER_STRIPE_WEBHOOK_SECRET=""

# Shipping providers (prepared, not required for local development)
MELHOR_ENVIO_TOKEN=""
CORREIOS_API_KEY=""
